# Copy to .env and fill in real values.

# PostgreSQL (preferred explicit URL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Or provide discrete values (used if DATABASE_URL is not set)
DB_HOST=13.126.11.184
DB_PORT=5432
DB_USER=serveaso
DB_PASSWORD=serveaso
DB_NAME=serveaso

# Server
PORT=3000

# Public API base URL (Swagger, CORS fallback). Replace with your real host.
APP_URL=https://api.yourdomain.com

# Optional: comma-separated browser origins allowed by CORS (if empty, all origins allowed in dev)
# CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# Optional: force Swagger "servers" URL only (defaults to APP_URL if unset)
# SWAGGER_SERVER_URL=https://api.yourdomain.com
