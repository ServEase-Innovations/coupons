# Copy to .env and fill in real values.

# PostgreSQL — on Render set DATABASE_URL or POSTGRES_DB (required)
# Postgres — set POSTGRES_DB (required). DB_NAME is synced from POSTGRES_DB at startup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/serveaso1"

# Or provide discrete values (used if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=serveaso
DB_PASSWORD=serveaso
POSTGRES_DB=serveaso1
DB_NAME=serveaso1

# Server
PORT=3000

# Public API base URL (Swagger, CORS fallback). Replace with your real host.
APP_URL=https://api.yourdomain.com

# Comma-separated browser origins (required in production; empty = allow all in dev)
# CORS_ORIGINS=http://localhost:3000,https://servease-innovation.netlify.app
CORS_ORIGINS=

# Optional: force Swagger "servers" URL only (defaults to APP_URL if unset)
# SWAGGER_SERVER_URL=https://api.yourdomain.com
